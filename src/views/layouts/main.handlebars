<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}} · Turnos</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="theme-{{pageKind}}">
    <a class="skip-link" href="#main-content">Ir al contenido</a>
    <header class="top">
      <a class="brand" href="/" aria-label="Turnos · Inicio">
        <svg class="brand-icon" viewBox="0 0 40 42" fill="none" aria-hidden="true">
          <rect x="2" y="6" width="33" height="32" rx="7" fill="#e0e3f5"/>
          <path d="M2 13a7 7 0 0 1 7-7h19a7 7 0 0 1 7 7v3H2z" fill="#484d79"/>
          <path d="M11 3v7M26 3v7" stroke="#a4abc9" stroke-width="3" stroke-linecap="round"/>
          <path d="M12 22h14M19 22v10" stroke="#393d63" stroke-width="3" stroke-linecap="round"/>
          <circle cx="32" cy="34" r="7" fill="#6965c8" stroke="#f4f7fc" stroke-width="2"/>
          <path d="M32 31v3h2" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <span>Turnos</span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="/services" {{#if (eq pageKind "services")}}class="is-active" aria-current="page"{{/if}}>Servicios</a>
        <a href="/bookings" {{#if (eq pageKind "bookings")}}class="is-active" aria-current="page"{{/if}}>Reservas</a>
        <a href="/realtime" {{#if (eq pageKind "realtime")}}class="is-active" aria-current="page"{{/if}}>Tiempo real{{#if (eq pageKind "realtime")}}<span id="realtime-nav-status" class="live-dot" data-state="connecting" aria-hidden="true"></span>{{/if}}</a>
        <a href="/api/services" target="_blank" rel="noopener noreferrer">API JSON<span class="sr-only"> (abre otra pestaña)</span></a>
      </nav>
    </header>
    <main class="page" id="main-content">
      {{{body}}}
    </main>
  </body>
</html>
