<p class="kicker"><a href="/bookings">← Reservas</a></p>
<h1>Reserva de {{booking.clientName}}</h1>

<ul class="facts">
  <li>Email: {{booking.clientEmail}}</li>
  <li>Fecha: {{booking.date}}</li>
  <li>Hora: {{booking.time}}</li>
  <li>Estado: <span class="status status-{{booking.status}}">{{statusLabel booking.status}}</span></li>
</ul>

<h2>Servicios asociados</h2>
{{#if booking.services.length}}
  <ul class="list">
    {{#each booking.services}}
      <li>
        {{#if (isPopulatedService service)}}
          {{service.name}}
          <span>{{service.category}} · {{service.duration}} min · USD {{service.price}} · x{{quantity}}</span>
        {{else}}
          Servicio {{service}}
          <span>cantidad {{quantity}}</span>
        {{/if}}
      </li>
    {{/each}}
  </ul>
{{else}}
  <p>Esta reserva todavía no tiene servicios.</p>
{{/if}}
